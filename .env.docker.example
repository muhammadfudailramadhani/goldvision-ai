# ============================================================
# GoldVision AI — environment
# Salin jadi .env dan isi. JANGAN pernah commit .env.
# ============================================================

# --- Application ---
APP_ENV=development

# --- Database ---
# Default: SQLite lokal (mode development). Production: PostgreSQL.
DATABASE_URL=sqlite:///./goldvision.db

# --- Channels (§4: WhatsApp WAJIB false sampai diminta aktivasi) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Market Data (§12: Twelve Data primary, Alpha Vantage fallback) ---
MARKET_DATA_MODE=mock
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- AI (mock untuk development; tidak ada panggilan LLM eksternal) ---
AI_MODE=mock

# --- Payment (§47: sandbox di localhost) ---
PAYMENT_MODE=sandbox
# --- LOCAL DEV ONLY ---
# Password di sini HANYA untuk container Docker lokal.
# Production: ganti lewat .env atau secret manager (Vault/AWS Secrets).
DB_PASSWORD=goldvision
